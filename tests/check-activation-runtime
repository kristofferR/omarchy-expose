#!/bin/bash
# Exercise the actual restore dispatch and timer without touching Hyprland.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
test_dir=$(mktemp -d)
trap 'rm -rf "$test_dir"' EXIT

sed -n '/^    function dispatchPendingActivation() {$/,/^    function requestClose(top) {$/p' Overview.qml \
  | sed '$d; s/Hyprland/hyprland/g' > "$test_dir/activation.qml"
[[ -s "$test_dir/activation.qml" ]] || {
  echo "activation check: could not extract restore dispatch from Overview.qml" >&2
  exit 1
}
cp WindowModel.js "$test_dir/WindowModel.js"
while IFS= read -r line; do
  if [[ $line == '// ACTIVATION COMPONENT' ]]; then
    cat "$test_dir/activation.qml"
  else
    printf '%s\n' "$line"
  fi
done < tests/runtime/activation.qml > "$test_dir/tst_activation.qml"

QT_QPA_PLATFORM=offscreen timeout 15s /usr/lib/qt6/bin/qmltestrunner -input "$test_dir/tst_activation.qml"
