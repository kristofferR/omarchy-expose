#!/bin/bash
set -euo pipefail

# Keep failures and hostile compositor metadata inside this short-lived helper,
# not the long-running Omarchy shell. Output is an optional workspace record
# followed by at most 256 bounded client records as NDJSON.
ulimit -v 131072

if ! timeout --signal=TERM --kill-after=1 2 hyprctl -j activeworkspace | jq -c '
  def bounded($n): if type == "string" then .[0:$n] else "" end;
  {
    kind: "workspace",
    id: (if (.id | type) == "number" then .id else 0 end),
    name: (.name | bounded(128))
  }
'; then
  :
fi

timeout --signal=TERM --kill-after=1 2 hyprctl -j clients | jq -c '
  def bounded($n): if type == "string" then .[0:$n] else "" end;
  def dimension: if type == "number" and . > 0 and . <= 32768 then floor else 0 end;
  limit(256;
    .[]
    | select(.mapped != false)
    | {
        kind: "client",
        address: (.address | bounded(32)),
        class: (.class | bounded(512)),
        initialClass: (.initialClass | bounded(512)),
        title: (.title | bounded(512)),
        workspace: {
          id: (if (.workspace.id | type) == "number" then .workspace.id else 0 end),
          name: (.workspace.name | bounded(128))
        },
        pinned: (.pinned == true),
        monitor: (if (.monitor | type) == "number" then .monitor else 0 end),
        size: (if (.size | type) == "array" then [(.size[0] | dimension), (.size[1] | dimension)] else [0, 0] end)
      }
  )
'
