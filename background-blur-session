#!/bin/bash
set -euo pipefail

command -v jq >/dev/null || { echo "expose: jq is required" >&2; exit 1; }
command -v timeout >/dev/null || { echo "expose: GNU timeout is required" >&2; exit 1; }
command -v flock >/dev/null || { echo "expose: flock is required" >&2; exit 1; }

runtime_dir=${XDG_RUNTIME_DIR:-}
[[ -n $runtime_dir && -d $runtime_dir && -O $runtime_dir ]] || {
  echo "expose: a user-owned XDG_RUNTIME_DIR is required" >&2
  exit 1
}
exec 9>"$runtime_dir/omarchy-expose-blur-session.lock"
flock 9

run_hyprctl() {
  timeout --signal=TERM --kill-after=1 2 hyprctl "$@"
}

wait_for_layer_close() {
  local attempt layer_present
  for attempt in {1..40}; do
    if layer_present=$(
      run_hyprctl -j layers |
        jq -r '[.. | objects | .namespace? // empty] | any(. == "expose-window-overview")'
    ) && [[ $layer_present == false ]]; then
      # Let any already-submitted layer commits drain before restoring blur.
      sleep 0.05
      return
    fi
    sleep 0.01
  done
  return 1
}

IFS=$'\t' read -r saved_enabled saved_size saved_contrast < <(
  run_hyprctl --batch -j 'getoption decoration:blur:enabled; getoption decoration:blur:size; getoption decoration:blur:contrast' |
    jq -ser '
      if length != 3 then error("expected three blur options") else . end
      | [
          (.[0]
            | if has("bool") then .bool
              elif has("int") then .int != 0
              else error("missing bool or int value")
              end
            | tostring),
          (.[1]
            | if has("int") and .int != null then .int | tostring
              else error("missing int value")
              end),
          (.[2]
            | if has("float") and .float != null then .float | tostring
              else error("missing float value")
              end)
        ]
      | @tsv'
)
restored=false
current_size=$saved_size
current_progress=1000

apply_saved_blur() {
  run_hyprctl eval "hl.config({ decoration = { blur = { enabled = ${saved_enabled}, size = ${saved_size}, contrast = ${saved_contrast} } } })" >/dev/null 2>&1
}

apply_blur_effect() {
  local size=$1
  local progress=$2
  local contrast
  contrast=$(jq -nr --argjson saved "$saved_contrast" --argjson progress "$progress" \
    '1 - (1 - $saved) * $progress / 1000')
  run_hyprctl eval "hl.config({ decoration = { blur = { enabled = true, size = ${size}, contrast = ${contrast} } } })" >/dev/null 2>&1
}

retry_saved_blur() {
  local attempt
  for attempt in 1 2 3; do
    if apply_saved_blur; then
      return 0
    fi
  done
  return 1
}

restore_blur_gradually() {
  if [[ $saved_enabled != true ]]; then
    retry_saved_blur
    return
  fi

  local from=$current_size
  local delta=$((saved_size - from))
  local steps=${delta#-}
  if (( steps < 6 )); then
    steps=6
  fi
  if (( steps > 8 )); then
    steps=8
  fi

  local step next_size next_progress
  for ((step = 1; step <= steps; step++)); do
    next_size=$((from + delta * step / steps))
    next_progress=$((current_progress + (1000 - current_progress) * step / steps))
    apply_blur_effect "$next_size" "$next_progress" || return 1
    current_size=$next_size
    if (( step < steps )); then
      sleep 0.016
    fi
  done
  current_progress=1000
  retry_saved_blur
}

restore_blur() {
  if [[ $restored == true ]]; then
    return
  fi
  if retry_saved_blur; then
    restored=true
  else
    echo "expose: could not restore the previous Hyprland blur settings" >&2
  fi
}

trap restore_blur EXIT
trap 'exit 0' HUP INT TERM

while IFS= read -r candidate; do
  requested_size=""
  requested_progress=1000
  close_requested=false
  while true; do
    if [[ $candidate == close ]]; then
      requested_size=""
      close_requested=true
    elif [[ $candidate =~ ^([0-9]{1,3}):([0-9]{1,4})$ ]]; then
      close_requested=false
      requested_size=$((10#${BASH_REMATCH[1]}))
      requested_progress=$((10#${BASH_REMATCH[2]}))
      if (( requested_size > 20 )); then
        requested_size=20
      fi
      if (( requested_progress > 1000 )); then
        requested_progress=1000
      fi
    elif [[ $candidate =~ ^[0-9]+$ ]]; then
      close_requested=false
      if [[ $candidate =~ ^0*([0-9]{1,2})$ ]]; then
        requested_size=$((10#${BASH_REMATCH[1]}))
      else
        requested_size=20
      fi
      if (( requested_size > 20 )); then
        requested_size=20
      fi
    fi
    IFS= read -r -t 0.02 candidate || break
  done

  if [[ $close_requested == true ]]; then
    wait_for_layer_close || echo "expose: timed out waiting for the overview layer to close" >&2
    if restore_blur_gradually; then
      restored=true
      printf '0\n'
    else
      echo "expose: could not restore the previous Hyprland blur settings" >&2
      printf '%s\n' -1
    fi
    continue
  fi

  [[ -n $requested_size ]] || continue
  if apply_blur_effect "$requested_size" "$requested_progress"; then
    restored=false
    current_size=$requested_size
    current_progress=$requested_progress
    printf '%s\n' "$requested_size"
  else
    printf '%s\n' -1
  fi
done
