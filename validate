#!/bin/bash
# Local checks: QML unit tests, qmllint, shell checks, and the plugin manifest.
#
# The qmltestrunner and qmllint on PATH are Qt 5 builds that exit without
# doing anything useful for this Qt 6 code, so the Qt 6 binaries are named
# explicitly.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

qt6_bin=/usr/lib/qt6/bin
[[ -x $qt6_bin/qmltestrunner && -x $qt6_bin/qmllint ]] || {
  echo "validate: Qt 6 qmltestrunner and qmllint are required in $qt6_bin (package qt6-declarative)" >&2
  exit 1
}
command -v omarchy >/dev/null || {
  echo "validate: omarchy is required for plugin manifest validation" >&2
  exit 1
}

# Vulkan on the offscreen platform segfaults Qt 6.12 (QTBUG-151795), so an
# inherited backend choice would turn every offscreen check into a crash.
unset QSG_RHI_BACKEND QT_QUICK_BACKEND

# A hanging test fails the run instead of hanging it.
QT_QPA_PLATFORM=offscreen timeout 300s "$qt6_bin/qmltestrunner" -input tests
./tests/check-hot-corner-runtime
./tests/check-theme-runtime
./tests/check-wallpaper-runtime

# Make the installed UI component types visible to qmllint. Commons' dynamic
# singleton objects remain runtime-injected, as in the shell itself.
# The code uses function-scoped var by convention; Qt 6.12 counts its
# block-scope warning toward --max-warnings without printing it.
lint_dir=$(mktemp -d)
trap 'rm -rf "$lint_dir"' EXIT
mkdir -p "$lint_dir/qs"
ln -s /usr/share/omarchy/shell/Ui "$lint_dir/qs/Ui"
"$qt6_bin/qmllint" \
  -I "$lint_dir" \
  --max-warnings 0 \
  --unqualified disable \
  --block-scope-var-declaration disable \
  Overview.qml WindowCard.qml WindowCapture.qml BackdropShadow.qml WorkspaceStrip.qml WindowBorders.qml SettingsView.qml ThemedControl.qml ThemeDivider.qml PluginSettings.qml WallpaperSource.qml WallpaperBackdrop.qml

# Lint the runtime fixture after injecting its host functions and imports.
./tests/check-settings-runtime --lint

# One file per call: bash -n checks only its first argument and hands the
# rest to that script as arguments.
for script in background-blur-session tests/live/check-ipc tests/check-theme-runtime tests/check-settings-runtime tests/check-hot-corner-runtime tests/check-wallpaper-runtime tests/check-blur-lock; do
  bash -n "$script"
done
timeout 15s ./tests/check-blur-lock

omarchy plugin validate .

echo "validate: all checks passed"
